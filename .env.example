# -----------------------------------------------------------------------------
# Environment variables for the contact form (Resend).
#
# LOCAL DEVELOPMENT:
#   Copy this file to ".env.local" and fill in your real values.
#   .env.local is git-ignored, so your secrets are never committed.
#
# PRODUCTION (Vercel):
#   Add these same variables under Project Settings -> Environment Variables.
#   See the README "Deployment Guide" for step-by-step instructions.
# -----------------------------------------------------------------------------

# Your Resend API key (create one at https://resend.com/api-keys). Keep secret.
RESEND_API_KEY=your_resend_api_key_here

# The email address that should receive contact form submissions.
CONTACT_EMAIL=your_personal_email@example.com
